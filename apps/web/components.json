{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-mira",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/index.css",
    "baseColor": "zinc",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "menuColor": "default",
  "menuAccent": "bold",
  "aliases": {
    "components": "~/components",
    "utils": "~/lib/utils",
    "ui": "~/components/ui",
    "lib": "~/lib",
    "hooks": "~/hooks"
  },
  "registries": {
    "@coss": "https://coss.com/ui/r/{name}.json",
    "@spell": "https://spell.sh/r/{name}.json",
    "@elements": "https://www.tryelements.dev/r/{name}.json",
    "@evilcharts": "https://evilcharts.com/r/{name}.json",
    "@iconiq": "https://iconiqui.com/r/{name}.json",
    "@ai-elements": "https://ai-sdk.dev/elements/api/registry/{name}.json",
    "@animate-ui": "https://animate-ui.com/r/{name}.json",
    "@gammaui": "https://www.gammaui.com/r/{name}.json",
    "@manifest": "https://ui.manifest.build/r/{name}.json",
    "@fluid": "https://www.fluidfunctionalism.com/r/{name}.json",
    "@loading-ui": "https://loading-ui.com/r/{name}.json"

  }
}
